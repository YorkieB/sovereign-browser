#!/usr/bin/env node
// ai-revert — read-only inspector + dry-run planner + confirmed execute mode.
//
// Post-revert verification is config-driven: reads .onecommit.json at the
// repo root for the list of verify commands (name, command, successText,
// optional failureText). Nothing here hardcodes npm/check/smoke - that was
// this repo's config, not a property of this script. If .onecommit.json is
// missing or invalid, execute mode refuses before ever running git revert.
//
// Git subcommands this file calls: log, rev-list, diff, show, rev-parse,
// status, revert. `revert` only runs in execute mode, only after every
// refusal check (including the config check) passes AND the user has typed
// REVERT at an interactive prompt. There is no git reset, git stash, or git
// tag -d anywhere in this file, and no code path writes to logs/ - the log
// entry for an execute run is a separate, later step, same as every other
// action in this project.
//
// Usage:
//   node scripts/ai-revert                       -> list recent candidates
//   node scripts/ai-revert <action-id|hash>       -> inspect one candidate
//   node scripts/ai-revert plan <action-id|hash>  -> dry-run revert plan
//   node scripts/ai-revert execute <action-id|hash> -> confirmed real revert

import { readFileSync } from "node:fs";
import { execFileSync } from "node:child_process";
import { createInterface } from "node:readline/promises";
import { stdin as input, stdout as output } from "node:process";

const JSONL_PATH = "logs/ai-action-log.jsonl";
const ONECOMMIT_CONFIG_PATH = ".onecommit.json";
const PROTECTED_PREFIXES = ["logs/", ".env", "backups/"];
const LIST_COUNT = 20;

function git(args) {
	return execFileSync("git", args, { encoding: "utf-8" }).trim();
}

function readActionLog() {
	let raw;
	try {
		raw = readFileSync(JSONL_PATH, "utf-8");
	} catch (err) {
		console.error(`[ai-revert] Could not read ${JSONL_PATH}: ${err.message}`);
		return { byCommit: new Map(), byActionId: new Map() };
	}
	const byCommit = new Map();
	const byActionId = new Map();
	const lines = raw.split("\n").filter((l) => l.trim().length > 0);
	for (const [i, line] of lines.entries()) {
		let entry;
		try {
			entry = JSON.parse(line);
		} catch (err) {
			console.warn(`[ai-revert] Skipping unparsable log line ${i + 1}: ${err.message}`);
			continue;
		}
		if (entry.action_id != null) byActionId.set(String(entry.action_id), entry);
		if (entry.commit) byCommit.set(entry.commit, entry);
	}
	return { byCommit, byActionId };
}

// Loads and validates .onecommit.json. Returns { ok: true, verify: [...] }
// or { ok: false, reason }. An explicitly-empty verify array is valid (ok:
// true, verify: []) and is distinct from a missing/invalid file (ok: false)
// - the two must never be conflated, since one means "no checks by design"
// and the other means "the config itself is broken".
function loadOneCommitConfig() {
	let raw;
	try {
		raw = readFileSync(ONECOMMIT_CONFIG_PATH, "utf-8");
	} catch (err) {
		return { ok: false, reason: `${ONECOMMIT_CONFIG_PATH} not found or unreadable: ${err.message}` };
	}
	let parsed;
	try {
		parsed = JSON.parse(raw);
	} catch (err) {
		return { ok: false, reason: `${ONECOMMIT_CONFIG_PATH} is not valid JSON: ${err.message}` };
	}
	if (!Array.isArray(parsed.verify)) {
		return { ok: false, reason: `${ONECOMMIT_CONFIG_PATH} must have a "verify" array (found ${typeof parsed.verify})` };
	}
	for (const [i, step] of parsed.verify.entries()) {
		if (!step || typeof step.name !== "string" || typeof step.command !== "string" || typeof step.successText !== "string") {
			return { ok: false, reason: `${ONECOMMIT_CONFIG_PATH} verify[${i}] must have string "name", "command", and "successText"` };
		}
		if (step.failureText !== undefined && typeof step.failureText !== "string") {
			return { ok: false, reason: `${ONECOMMIT_CONFIG_PATH} verify[${i}].failureText must be a string if present` };
		}
	}
	return { ok: true, verify: parsed.verify };
}

function recentCommits(count) {
	const sep = "\x1f";
	const out = git(["log", `-${count}`, `--format=%H${sep}%h${sep}%s`]);
	if (!out) return [];
	return out.split("\n").map((line) => {
		const [hash, short, subject] = line.split(sep);
		return { hash, short, subject };
	});
}

function parents(hash) {
	const out = git(["rev-list", "--parents", "-1", hash]);
	return out.split(" ").filter(Boolean).slice(1);
}

function touchedFiles(hash) {
	const p = parents(hash);
	if (p.length > 1) {
		const out = git(["diff", "--name-only", p[0], hash]);
		return out ? out.split("\n").filter(Boolean) : [];
	}
	const out = git(["show", "--name-only", "--format=", hash]);
	return out ? out.split("\n").filter(Boolean) : [];
}

function protectedPathHits(files) {
	return files.filter((f) =>
		PROTECTED_PREFIXES.some((p) => f === p.replace(/\/$/, "") || f.startsWith(p)),
	);
}

function eligibility(hash, logEntry) {
	const reasons = [];
	if (logEntry && logEntry.revertable === false) {
		reasons.push(`log entry for action ${logEntry.action_id} is explicitly marked revertable:false`);
	}
	if (logEntry && !logEntry.commit) {
		reasons.push(`log entry for action ${logEntry.action_id} has no commit (commit:null) - nothing to revert`);
	}
	const p = parents(hash);
	const isMerge = p.length > 1;
	if (isMerge) {
		reasons.push(`merge commit (${p.length} parents) - needs -m <parent-number>, not handled by this build`);
	}
	const files = touchedFiles(hash);
	const hits = protectedPathHits(files);
	if (hits.length) {
		reasons.push(`touches protected path(s): ${hits.join(", ")}`);
	}
	return { eligible: reasons.length === 0, reasons, isMerge, files, protectedHits: hits };
}

function resolveTarget(target) {
	const { byCommit, byActionId } = readActionLog();
	if (byActionId.has(target)) {
		const logEntry = byActionId.get(target);
		if (!logEntry.commit) {
			return { ok: false, reason: "no-commit", logEntry };
		}
		return { ok: true, hash: logEntry.commit, logEntry };
	}
	try {
		const hash = git(["rev-parse", "--verify", target]);
		return { ok: true, hash, logEntry: byCommit.get(hash) || null };
	} catch (err) {
		return { ok: false, reason: "not-found", message: err.message };
	}
}

function isTreeDirty() {
	return git(["status", "--porcelain"]).length > 0;
}

function isRevertInProgress() {
	try {
		git(["rev-parse", "--verify", "REVERT_HEAD"]);
		return true;
	} catch {
		return false;
	}
}

function formatList() {
	const { byCommit, byActionId } = readActionLog();
	const commits = recentCommits(LIST_COUNT);
	console.log(`[ai-revert] Read-only listing - last ${commits.length} commits, cross-referenced with ${JSONL_PATH}\n`);
	for (const c of commits) {
		const entry = byCommit.get(c.hash);
		const elig = eligibility(c.hash, entry);
		const label = entry ? `action ${entry.action_id}` : "no log entry";
		const tag = elig.eligible ? `${label} - eligible` : `${label} - INELIGIBLE (${elig.reasons.join("; ")})`;
		console.log(`${c.short}  ${c.subject}`);
		console.log(`    -> ${tag}`);
	}
	const noCommitActions = [...byActionId.values()].filter((e) => !e.commit);
	if (noCommitActions.length) {
		console.log("\n--- logged actions with no commit (not revertable via this tool) ---");
		for (const e of noCommitActions) {
			const why = e.revertable === false ? "revertable:false in the log" : "commit:null in the log";
			console.log(`action ${e.action_id}: ${e.instruction}`);
			console.log(`    -> INELIGIBLE (no commit associated - ${why})`);
		}
	}
	console.log("\n[ai-revert] Read-only inspector - no revert capability from list mode.");
}

function formatInspect(target) {
	const r = resolveTarget(target);
	if (!r.ok) {
		if (r.reason === "no-commit") {
			console.log(`[ai-revert] Action ${target}: no commit associated (commit:null in the log).`);
			console.log("[ai-revert] Not eligible for revert via this tool - nothing to revert.");
		} else {
			console.error(`[ai-revert] "${target}" is not a known action id and not a valid commit: ${r.message}`);
			process.exitCode = 1;
		}
		return;
	}
	const { hash, logEntry } = r;
	console.log(`[ai-revert] Inspecting ${hash}${logEntry ? ` (action ${logEntry.action_id})` : " (no log entry)"}\n`);
	console.log("--- git show --stat ---");
	console.log(git(["show", "--stat", hash]));
	const elig = eligibility(hash, logEntry);
	console.log("\n--- eligibility (informational only) ---");
	console.log(`Merge commit: ${elig.isMerge ? "yes" : "no"}`);
	console.log(`Files touched: ${elig.files.join(", ") || "(none detected)"}`);
	console.log(`Protected-path hit: ${elig.protectedHits.length ? elig.protectedHits.join(", ") : "none"}`);
	console.log(`Eligible for a future revert: ${elig.eligible ? "YES" : "NO"}`);
	if (!elig.eligible) {
		console.log(`Reason(s): ${elig.reasons.join("; ")}`);
	}
}

function formatPlan(target) {
	const r = resolveTarget(target);
	if (!r.ok) {
		if (r.reason === "no-commit") {
			console.log(`[ai-revert] PLAN REFUSED for ${target}: no commit associated (commit:null in the log) - nothing to revert.`);
		} else {
			console.error(`[ai-revert] PLAN REFUSED: "${target}" is not a known action id and not a valid commit: ${r.message}`);
			process.exitCode = 1;
		}
		return;
	}
	const { hash, logEntry } = r;
	console.log(`[ai-revert] Dry-run plan for ${hash}${logEntry ? ` (action ${logEntry.action_id})` : " (no log entry)"}\n`);
	console.log("--- git show --stat ---");
	console.log(git(["show", "--stat", hash]));
	const elig = eligibility(hash, logEntry);
	console.log(`\nFiles touched: ${elig.files.join(", ") || "(none detected)"}`);
	if (logEntry && logEntry.revertable === false) {
		console.log(`\n[ai-revert] PLAN REFUSED: log entry for action ${logEntry.action_id} is explicitly marked revertable:false.`);
		return;
	}
	if (elig.protectedHits.length) {
		console.log(`\n[ai-revert] PLAN REFUSED: touches protected path(s): ${elig.protectedHits.join(", ")}.`);
		return;
	}
	if (elig.isMerge) {
		console.log("\n[ai-revert] PLAN REFUSED: this is a merge commit. Merge revert support is not implemented yet in this build.");
		return;
	}
	console.log("\n--- dry-run plan (nothing below this line has been run) ---");
	console.log(`Would run:      git revert --no-edit ${hash}`);
	const config = loadOneCommitConfig();
	if (!config.ok) {
		console.log(`Would then run: (cannot determine - ${ONECOMMIT_CONFIG_PATH} problem: ${config.reason})`);
		console.log("[ai-revert] Execute mode would REFUSE this target because of the config problem above, before ever reverting.");
	} else if (config.verify.length === 0) {
		console.log(`Would then run: (nothing - ${ONECOMMIT_CONFIG_PATH} explicitly configures zero verification commands)`);
	} else {
		for (const step of config.verify) {
			console.log(`Would then run: ${step.command}  (${step.name})`);
		}
		console.log("Pass/fail would be judged by each command's configured successText/failureText in its output - never by exit codes.");
	}
	console.log("\n[ai-revert] Dry-run only - no git revert, reset, stash, or commit has been executed.");
}

async function confirmRevert(hash, logEntry) {
	const rl = createInterface({ input, output });
	try {
		const answer = await rl.question(
			`\nType REVERT to confirm reverting ${hash}${logEntry ? ` (action ${logEntry.action_id})` : ""}. Anything else cancels: `,
		);
		return answer.trim() === "REVERT";
	} finally {
		rl.close();
	}
}

function runCapture(cmd, args) {
	try {
		// shell:true so npm.cmd resolves correctly via PATH on Windows -
		// execFileSync without it fails with ENOENT for .cmd-shimmed tools
		// even when the same command works fine typed into a real shell.
		const out = execFileSync(cmd, args, { encoding: "utf-8", shell: true });
		return { out, failed: false };
	} catch (err) {
		const out = (err.stdout ? err.stdout.toString() : "") + (err.stderr ? err.stderr.toString() : "") + (err.message || "");
		return { out, failed: true };
	}
}

// Runs every configured verify step and judges each by its own configured
// successText/failureText - never by exit code. An explicitly-empty list
// is a pass by design (the config said so), with a clear note explaining
// why, not silence.
function runVerifySteps(verifySteps) {
	if (verifySteps.length === 0) {
		console.log(`[ai-revert] No verification commands are configured in ${ONECOMMIT_CONFIG_PATH} (verify: []) - treating as pass by design.`);
		return { allPassed: true, results: [] };
	}
	const results = [];
	let allPassed = true;
	for (const step of verifySteps) {
		console.log(`\n[ai-revert] Verifying: ${step.command}  (${step.name})`);
		const parts = step.command.trim().split(/\s+/).filter(Boolean);
		const cmd = parts[0];
		const args = parts.slice(1);
		const r = runCapture(cmd, args);
		console.log(r.out);
		const successFound = r.out.includes(step.successText);
		const failureFound = step.failureText ? r.out.includes(step.failureText) : false;
		const passed = successFound && !failureFound;
		if (!passed) allPassed = false;
		results.push({ name: step.name, passed, successFound, failureFound });
		console.log(
			`${step.name}: ${successFound ? `"${step.successText}" found` : `"${step.successText}" NOT found`}` +
				(step.failureText ? `, ${failureFound ? `"${step.failureText}" present` : `"${step.failureText}" absent`}` : ""),
		);
	}
	return { allPassed, results };
}

async function formatExecute(target) {
	const r = resolveTarget(target);
	if (!r.ok) {
		if (r.reason === "no-commit") {
			console.log(`[ai-revert] EXECUTE REFUSED for ${target}: no commit associated (commit:null in the log) - nothing to revert.`);
		} else {
			console.error(`[ai-revert] EXECUTE REFUSED: "${target}" is not a known action id and not a valid commit: ${r.message}`);
			process.exitCode = 1;
		}
		return;
	}
	const { hash, logEntry } = r;

	console.log(`[ai-revert] Execute request for ${hash}${logEntry ? ` (action ${logEntry.action_id})` : " (no log entry)"}\n`);
	console.log("--- git show --stat ---");
	console.log(git(["show", "--stat", hash]));

	const elig = eligibility(hash, logEntry);
	console.log(`\nFiles touched: ${elig.files.join(", ") || "(none detected)"}`);

	// Verification config is checked before every other refusal check: if
	// we can't verify a revert afterward, there's no point evaluating
	// whether this specific target would otherwise be eligible.
	const config = loadOneCommitConfig();
	if (!config.ok) {
		console.log(`\n[ai-revert] EXECUTE REFUSED: ${ONECOMMIT_CONFIG_PATH} problem - ${config.reason}`);
		return;
	}

	if (logEntry && logEntry.revertable === false) {
		console.log(`\n[ai-revert] EXECUTE REFUSED: log entry for action ${logEntry.action_id} is explicitly marked revertable:false.`);
		return;
	}
	if (elig.protectedHits.length) {
		console.log(`\n[ai-revert] EXECUTE REFUSED: touches protected path(s): ${elig.protectedHits.join(", ")}.`);
		return;
	}
	if (elig.isMerge) {
		console.log("\n[ai-revert] EXECUTE REFUSED: this is a merge commit. Merge revert support is not implemented in this build - use a separate, explicit flow for merges.");
		return;
	}
	if (isRevertInProgress()) {
		console.log("\n[ai-revert] EXECUTE REFUSED: a revert is already in progress (REVERT_HEAD exists).");
		console.log("Recovery command: git revert --abort");
		return;
	}
	if (isTreeDirty()) {
		console.log("\n[ai-revert] EXECUTE REFUSED: working tree is not clean.");
		console.log(git(["status", "--porcelain"]));
		return;
	}

	console.log("\n--- plan (nothing has been run yet) ---");
	console.log(`Would run:      git revert --no-edit ${hash}`);
	if (config.verify.length === 0) {
		console.log(`Would then run: (nothing - ${ONECOMMIT_CONFIG_PATH} explicitly configures zero verification commands)`);
	} else {
		for (const step of config.verify) {
			console.log(`Would then run: ${step.command}  (${step.name})`);
		}
	}

	const confirmed = await confirmRevert(hash, logEntry);
	if (!confirmed) {
		console.log("\n[ai-revert] Not confirmed - nothing done.");
		return;
	}

	console.log(`\n[ai-revert] Running: git revert --no-edit ${hash}`);
	const revertResult = runCapture("git", ["revert", "--no-edit", hash]);
	console.log(revertResult.out);
	if (revertResult.failed) {
		if (isRevertInProgress()) {
			console.log("[ai-revert] Conflict - a revert is now in progress. This tool will NOT resolve it automatically.");
			console.log("Recovery command: git revert --abort");
		} else {
			console.log("[ai-revert] git revert failed for a reason other than a normal conflict. Manual review needed.");
		}
		process.exitCode = 1;
		return;
	}

	const newHash = git(["rev-parse", "HEAD"]);
	console.log(`[ai-revert] Revert commit created: ${newHash}`);

	const verification = runVerifySteps(config.verify);

	if (verification.allPassed) {
		console.log(`\n[ai-revert] Verification passed (judged by output text, not exit codes). Revert commit: ${newHash}`);
	} else {
		console.log("\n[ai-revert] Verification FAILED or inconclusive after the revert.");
		console.log("[ai-revert] Manual review needed. This tool will NOT auto-reset or revert-the-revert.");
		process.exitCode = 1;
	}
}

async function main() {
	const [first, second] = process.argv.slice(2);
	if (!first) {
		formatList();
		return;
	}
	if (first === "plan") {
		if (!second) {
			console.error('[ai-revert] "plan" requires a target: node scripts/ai-revert plan <action-id-or-hash>');
			process.exitCode = 1;
			return;
		}
		formatPlan(second);
		return;
	}
	if (first === "execute") {
		if (!second) {
			console.error('[ai-revert] "execute" requires a target: node scripts/ai-revert execute <action-id-or-hash>');
			process.exitCode = 1;
			return;
		}
		await formatExecute(second);
		return;
	}
	formatInspect(first);
}

main();
