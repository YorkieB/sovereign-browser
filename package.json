{
	"name": "holly",
	"version": "0.1.0",
	"description": "Lightweight web browser experiment built with Electron",
	"main": "main.js",
	"scripts": {
		"start": "electron .",
		"build": "electron-builder --win",
		"check": "node --check main.js && node --check preload.js && node --check src/renderer.js && echo CHECK-PASSED"
	},
	"author": "",
	"license": "GPL-3.0",
	"build": {
		"appId": "com.holly.app",
		"productName": "HOLLY",
		"files": [
			"main.js",
			"preload.js",
			"src/**/*",
			"node_modules/**/*"
		],
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				},
				{
					"target": "portable",
					"arch": [
						"x64"
					]
				}
			]
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"shortcutName": "HOLLY"
		}
	},
	"devDependencies": {
		"electron": "^43.2.0",
		"electron-builder": "^24.13.3"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.24.0",
		"debug": "^4.3.4",
		"dotenv": "^16.0.3",
		"electron-chrome-extensions": "^4.9.0",
		"electron-chrome-web-store": "^0.13.0",
		"openai": "^6.16.0",
		"winreg": "^1.2.5"
	}
}

